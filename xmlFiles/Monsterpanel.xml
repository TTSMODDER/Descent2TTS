<Panel id="monster_root_panel" 
       width="250" height="150" 
       position="600 350" 
       allowDragging="true" 
       returntooriginalpositionwhenreleased="false" 
       image = "https://steamusercontent-a.akamaihd.net/ugc/38946813293844664/7F47448FF4A1520BFE79A291B47FAD1D8D1BE088/"
       visibility="White|Black">   


    <Text id="selected_monster_name" 
          text="Monstername"
          fontSize="20"
          position="0 -4"
          alignment="MiddleCenter"
          color="#FFFFFF"/>

    <Text id="selected_monster_health" 
          text="0/0"
          fontSize="25"
          position="0 -30"
           alignment="MiddleCenter"
          color="#FFFFFF"/>



    <!-- +/- Buttons im Root Panel -->
    <Button id="health_up" 
            width="30" height="30"
            position="-100 35"
            colors="#22222215|#22222250|#222222|#FF0000"
            onClick="adjustSelectedMonsterHealth"/>
            
    <Button id="health_down"
            width="30" height="30" 
            position="-100 -35"     
            colors="#22222215|#22222250|#222222|#FF0000"
            onClick="adjustSelectedMonsterHealth"/>

<Button id="attack_button"
        width="40" height="40"
        position="-30 55"
         tooltip="Angriff" colors="#22222215|#22222250|#222222|#FF0000"
        onClick="MonsterAttackButton" />

<Button id="defense_button"
        width="40" height="40"
        position="20 55"
        tooltip="Abwehr" colors="#22222215|#22222250|#222222|#FF0000"
        onClick="MonsterDefendButton"/>

<Button id="probe_button"
        width="35" height="35"
        position="-27 -55"
        active="true"  
        tooltip="Abwehr" colors="#22222215|#22222250|#222222|#FF0000"
        onClick="probe"/>

<Button id="healing_button"
        width="35" height="35"
        position="20 -55"
        tooltip="Abwehr" colors="#22222215|#22222250|#222222|#FF0000"
        active="true"
        onClick="heal"/>

<Button id="ol_view_button"
        width="50" height="50"
        position="100 -50"
      colors="#22222215|#22222250|#222222|#FF0000"
       onClick="toggleOLView"/>



    <!-- Aktualisieren-Button -->
    <Button id="refresh_button"
            width="30" height="30"
            
            position="80 60"
            text="↻"
            fontStyle="Bold"
            fontSize="20"
            textColor="#FFFFFF"
            color="#000000"
            onClick="Monsterliste_onload"/>

    <!-- toogle visib-Button -->
    <Button id="toggle_panels_button"
            width="30" height="30"
            position="110 60"
            text="-"      
            fontStyle="Bold"
            fontSize="20"
            textColor="#FFFFFF"
            color="#000000"
            onClick="togglePanelsVisibility"/>

  
    <Button id="toggle_dice_button"
            tooltip="würfelboard"
            colors="#22222215|#22222250|#222222|#FF0000"
            width="35" 
            height="35"
            position="100 3"
            onClick="toggleDicePanel" />

             <!-- Minipanel_ -->
            <Panel id="dice_small_root" width="150" height="25" position="0 -65 0" color="rgba(0,0,0)" active="false">
                <Button id="Red" width="15.625" height="15.625" position="-60 0 0" color="#FF0000CC" onClick="wuerfeln"/>
                <Button id="Blue" width="15.625" height="15.625" position="-40 0 0" color="#0000FFCC" onClick="wuerfeln"/>
                <Button id="Yellow" width="15.625" height="15.625" position="-20 0 0" color="#FFFF00CC" onClick="wuerfeln"/>
                <Button id="Green" width="15.625" height="15.625" position="0 0 0" color="#00FF00CC" onClick="wuerfeln"/>
                <Button id="Grey" width="15.625" height="15.625" position="20 0 0" color="#D3D3D3CC" onClick="wuerfeln"/>
                <Button id="Black" width="15.625" height="15.625" position="40 0 0" color="#404040" onClick="wuerfeln"/>
                <Button id="Brown" width="15.625" height="15.625" position="60 0 0" color="#A52A2ACC" onClick="wuerfeln"/>
            </Panel>



